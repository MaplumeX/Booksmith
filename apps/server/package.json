{
  "name": "@booksmith/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "@booksmith/core": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@node-rs/argon2": "^2.2.2",
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "postgres": "^4.1.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19"
  }
}
